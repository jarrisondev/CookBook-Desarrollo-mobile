rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isRider() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'rider';
    }

    function isDriver() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'driver';
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isMe(uid);
      allow update, delete: if isMe(uid);
    }

    match /rides/{rideId} {
      allow read: if isSignedIn()
        && (resource.data.riderId == request.auth.uid
            || resource.data.driverId == request.auth.uid
            || (resource.data.status == 'searching' && isDriver()));

      allow create: if isSignedIn()
        && request.resource.data.riderId == request.auth.uid
        && request.resource.data.status == 'searching'
        && isRider();

      allow update: if isSignedIn() && (
        (resource.data.riderId == request.auth.uid
          && request.resource.data.diff(resource.data).changedKeys()
              .hasOnly(['status', 'cancelledAt', 'rating', 'comment']))
        ||
        (isDriver() && resource.data.status == 'searching'
          && request.resource.data.status == 'accepted'
          && request.resource.data.driverId == request.auth.uid)
        ||
        (resource.data.driverId == request.auth.uid
          && request.resource.data.diff(resource.data).changedKeys()
              .hasOnly(['status', 'arrivedAt', 'startedAt', 'completedAt',
                        'finalFare', 'tip', 'cancelledAt']))
      );

      allow delete: if false;
    }
  }
}
